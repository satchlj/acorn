# acorn-app.env: sourced by acorn's tools (zsh and bash), from the app's repository root.
APP_NAME=Puzil                    # the name people see
APP_BIN=puzil                     # the executable's name inside the bundle
APP_PACKAGE=puzil-app             # the cargo package to build
APP_CARGO_BIN=puzil-app           # the binary cargo builds (target/dist/<this>)
APP_ID=com.satchlj.puzil          # bundle id, desktop file id, Wayland app id
ENV_PREFIX=PUZIL                  # <PREFIX>_SIGN_ID, <PREFIX>_NOTARY_PROFILE, <PREFIX>_UPDATE_KEY_FILE
MAC_ICNS=assets/icon/Puzil.icns
MAC_INFO_PLIST=tools/macos/Info.plist.in   # @VERSION@ and @BUILD@ are filled in
MAC_SIGN_CERT="Puzil Self-Signed" # used when the keychain has it, else ad hoc
LINUX_PNG=assets/icon/puzil-512.png
LINUX_DESKTOP=tools/linux/com.satchlj.puzil.desktop.in   # @BIN@ is filled in
LINUX_SCHEME=zulip                # registered as this x-scheme-handler on install (optional)
