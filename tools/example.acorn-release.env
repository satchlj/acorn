# acorn-release.env: release settings, sourced by release/snapshot.sh and release/publish.sh.
# Private: the snapshot never copies this file into the public tree.
PUBLIC_REPO=satchlj/puzil         # where release/publish.sh publishes
PUBLIC_DESCRIPTION="A fast native Zulip client"
SNAPSHOT_DROP="docs spikes"       # left out of the public tree
SNAPSHOT_DENY="password|secret_key|gho_[A-Za-z0-9]{20}"   # refuse to publish if these appear...
SNAPSHOT_ALLOW="satchlj/puzil"    # ...except in these strings
